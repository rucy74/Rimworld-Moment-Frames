<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- pauseMode: the game pauses when the player's "Pause on letter" option is at or above this value
       (LetterStack.ReceiveLetter: Prefs.AutomaticPauseMode >= def.pauseMode).
       AnyLetter = only players who chose "Any letter", the same as the game's ordinary letters.
       Never is the lowest value, so it would pause the game for every player, even with the option off.
       tools/check-letter-pause.py keeps it that way. -->

  <!-- "N years ago today": a letter that opens a photo. -->
  <LetterDef>
    <defName>MF_PhotoLetter</defName>
    <letterClass>MomentFrames.Letter_MFPhoto</letterClass>
    <color>(0.72, 0.82, 0.80)</color>
    <flashColor>(0.86, 0.92, 0.90)</flashColor>
    <arriveSound>LetterArrive</arriveSound>
    <pauseMode>AnyLetter</pauseMode>
  </LetterDef>

  <!-- A colonist's birthday: take a photo, and where? Waits a day. -->
  <LetterDef>
    <defName>MF_BirthdayLetter</defName>
    <letterClass>MomentFrames.ChoiceLetter_MFBirthday</letterClass>
    <color>(0.95, 0.78, 0.82)</color>
    <flashColor>(1, 0.88, 0.9)</flashColor>
    <arriveSound>LetterArrive</arriveSound>
    <pauseMode>AnyLetter</pauseMode>
  </LetterDef>

  <!-- The year in photos: when the colony's year turns. Opens the album on that year or a memory night on its photos. -->
  <LetterDef>
    <defName>MF_YearLetter</defName>
    <letterClass>MomentFrames.Letter_MFYear</letterClass>
    <color>(0.91, 0.80, 0.58)</color>
    <flashColor>(1, 0.92, 0.7)</flashColor>
    <arriveSound>LetterArrive</arriveSound>
    <pauseMode>AnyLetter</pauseMode>
  </LetterDef>

</Defs>
